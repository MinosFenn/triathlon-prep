# ─── App ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Garmin Connect Developer Program ──────────────────────────────
# 1. Request access: https://developer.garmin.com/gc-developer-program/activity-api/
# 2. Create app at https://developerportal.garmin.com (Evaluation)
# 3. Redirect URI must match exactly:
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
GARMIN_REDIRECT_URI=http://localhost:3000/api/garmin/callback

# Webhook URL (configure in Garmin Developer Portal → API Tools → Push):
#   https://YOUR-DOMAIN.vercel.app/api/garmin/webhook
GARMIN_WEBHOOK_SECRET=

# Optional: single-user mode (your internal athlete id)
GARMIN_ATHLETE_ID=simon

# ─── Persistence (required on Vercel — optional locally) ───────────
# Upstash Redis: https://upstash.com (free tier)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
